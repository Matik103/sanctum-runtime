{
  "name": "@sanctum-runtime/adapters",
  "version": "0.2.0",
  "description": "Sanctum Runtime framework adapters — gate every agent / robot / MCP / workflow action through Sanctum. Includes provider-neutral model-tool dispatch for OpenAI, Claude, Gemini, Grok, DeepSeek, NVIDIA NIM and compatible APIs, plus LangChain, Vercel AI SDK, OpenAI Agents, MCP, CrewAI, ROS2 and more.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "ai-agents", "agent-security", "agent-middleware", "agent-gateway",
    "langchain", "vercel-ai-sdk", "openai-agents", "mastra",
    "mcp", "model-context-protocol", "crewai", "autogen", "pydantic-ai",
    "llamaindex", "smolagents", "bedrock-agents", "browser-use",
    "home-assistant", "n8n", "zapier", "ros2", "claude-desktop",
    "computer-use", "tool-use", "function-calling", "gemini", "grok", "deepseek", "nvidia-nim", "indirect-prompt-injection",
    "runtime", "policy-engine", "sanctum"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./langchain": "./dist/langchain.js",
    "./vercel-ai": "./dist/vercel-ai.js",
    "./openai-agents": "./dist/openai-agents.js",
    "./mastra": "./dist/mastra.js",
    "./mcp": "./dist/mcp.js",
    "./crewai": "./dist/crewai.js",
    "./ros2": "./dist/ros2.js",
    "./claude-desktop": "./dist/claude-desktop.js",
    "./n8n": "./dist/n8n.js",
    "./autogen": "./dist/autogen.js",
    "./pydantic-ai": "./dist/pydantic-ai.js",
    "./llamaindex": "./dist/llamaindex.js",
    "./smolagents": "./dist/smolagents.js",
    "./bedrock-agents": "./dist/bedrock-agents.js",
    "./browser-use": "./dist/browser-use.js",
    "./home-assistant": "./dist/home-assistant.js",
    "./model-tools": "./dist/model-tools.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@sanctum-runtime/sdk": "*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@sanctum-runtime/sdk": "*"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}

{
  "name": "@sanctum-runtime/adapters",
  "version": "0.1.0",
  "description": "Framework adapters for Sanctum Runtime — LangChain, Vercel AI SDK, AutoGen, CrewAI, OpenAI Agents",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./langchain": "./dist/langchain.js",
    "./vercel-ai": "./dist/vercel-ai.js",
    "./openai-agents": "./dist/openai-agents.js",
    "./mastra": "./dist/mastra.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@sanctum-runtime/sdk": "*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@sanctum-runtime/sdk": "*"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}

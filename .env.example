# Copy to .env and set values for your environment (required for dev:runtime, smoke, examples).
# cp .env.example .env

# --- Runtime API ---
HOST=127.0.0.1
PORT=3001
# Or set a single URL instead of HOST+PORT:
# SANCTUM_API_URL=http://127.0.0.1:3001

SANCTUM_OFFLINE_MODE=false

# Optional: require X-Sanctum-Key on API routes (set same value for SDK/scripts)
# SANCTUM_API_KEY=

# --- Supabase (optional — dashboard login + JWT on API; see SUPABASE_SETUP.md) ---
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server only — never expose to browser

# --- Community dashboard (dev server) ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5174
# Or:
# DASHBOARD_URL=http://127.0.0.1:5174

# --- Marketing site (npm run dev) ---
SITE_HOST=127.0.0.1
SITE_PORT=8080

# --- SDK / scripts (optional if HOST+PORT or SANCTUM_API_URL is set) ---
# SANCTUM_API_URL=http://127.0.0.1:3001

# --- Ollama (local risk analysis) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-3b-instruct

# --- Marketing site overrides (optional) ---
# VITE_DOCS_PATH=/docs
# VITE_GITHUB_URL=https://github.com/Matik103/sanctum-runtime
# VITE_EARLY_ACCESS_URL=https://your-form.example/enterprise-waitlist
# VITE_PRIVACY_URL=/privacy

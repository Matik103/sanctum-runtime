# Copy to .env and set values for your environment (required for dev:runtime, smoke, examples).
# cp .env.example .env

# --- Runtime API ---
HOST=127.0.0.1
PORT=3001
# Or set a single URL instead of HOST+PORT:
# SANCTUM_API_URL=http://127.0.0.1:3001

SANCTUM_OFFLINE_MODE=false

# Optional: legacy single-server key (scripts); dashboard keys use sk_sanctum_* in DB
# SANCTUM_API_KEY=

# Required in production for dashboard-issued API keys (peppered bcrypt, OpenAI-style)
# Generate: openssl rand -base64 32
# SANCTUM_API_KEY_PEPPER=

# --- Supabase (optional — dashboard login + JWT on API; see SUPABASE_SETUP.md) ---
# Pull from your project: npm run env:pull   (requires: supabase login)
# SUPABASE_PROJECT_REF=nimvcudvrhanxlcpiizz
# Use project root URL only — NOT .../rest/v1/
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_SERVICE_ROLE_KEY=   # server/API only — never in dashboard static build
# API also reads non-prefixed aliases (set automatically by env:pull):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Community dashboard (dev server) ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5174
# Or:
# DASHBOARD_URL=http://127.0.0.1:5174

# --- Dashboard production build (Render static site — baked into bundle) ---
# VITE_DOCS_URL=https://www.sanctumruntime.com/docs
# VITE_MARKETING_URL=https://www.sanctumruntime.com
# VITE_SANCTUM_API_URL=https://your-api.onrender.com
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# --- Marketing site (npm run dev) ---
SITE_HOST=127.0.0.1
SITE_PORT=8080

# --- SDK / scripts (optional if HOST+PORT or SANCTUM_API_URL is set) ---
# SANCTUM_API_URL=http://127.0.0.1:3001

# --- Risk model (optional — policy + heuristics work without any model) ---
# Provider: ollama | openai | none  (default: ollama if OLLAMA_URL set, else openai if OPENAI_API_KEY set)
# SANCTUM_RISK_PROVIDER=ollama
# SANCTUM_RISK_MODEL=   # overrides OLLAMA_MODEL / OPENAI_MODEL

# Ollama (local)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-3b-instruct

# OpenAI-compatible APIs (OpenAI, vLLM, LiteLLM, Groq, Together, etc.)
# SANCTUM_RISK_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Webhooks (optional — OSS: HTTP POST on verify/block/resolve) ---
# SANCTUM_WEBHOOK_URL=https://your-server.com/sanctum/events
# SANCTUM_WEBHOOK_URLS=https://a.example/hook,https://b.example/hook
# SANCTUM_WEBHOOK_SECRET=   # optional HMAC sha256 → X-Sanctum-Signature header
# SANCTUM_WEBHOOK_EVENTS=verification.required,action.blocked,verification.resolved

# --- Marketing site overrides (optional) ---
# VITE_CONSOLE_URL=https://console.sanctumruntime.com/
# VITE_MARKETING_URL=https://www.sanctumruntime.com/
# VITE_DOCS_PATH=/docs
# VITE_GITHUB_URL=https://github.com/Matik103/sanctum-runtime
# VITE_EARLY_ACCESS_URL=https://console.sanctumruntime.com/
# VITE_PRIVACY_URL=/privacy

{
  "name": "sanctum-runtime",
  "description": "Open-source trust layer for autonomous AI — gate agent, robot, smart home, and industrial actions before they run. MIT.",
  "packageManager": "npm@10.9.2",
  "private": true,
  "homepage": "https://github.com/Matik103/sanctum-runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matik103/sanctum-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/Matik103/sanctum-runtime/issues"
  },
  "keywords": [
    "ai-agents",
    "robotics",
    "smart-home",
    "iot",
    "llm-security",
    "guardrails",
    "policy-engine",
    "open-source"
  ],
  "sideEffects": false,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/adapters/*",
    "services/*"
  ],
  "scripts": {
    "dev": "vite dev",
    "dev:api": "npm run dev -w @sanctum/api",
    "dev:dashboard": "npm run dev -w @sanctum/dashboard",
    "dev:runtime": "concurrently -n api,dash -c blue,magenta \"npm run dev:api\" \"node scripts/wait-for-api.mjs && npm run dev:dashboard\"",
    "dev:all": "concurrently -n api,dash,site -c blue,magenta,green \"npm run dev:api\" \"npm run dev:dashboard\" \"npm run dev\"",
    "smoke": "tsx scripts/smoke-test.ts",
    "gen:vapid": "node scripts/gen-vapid.mjs",
    "gen:secrets": "node -e \"const c=require('crypto');console.log('SANCTUM_ACTION_TOKEN_SECRET='+c.randomBytes(32).toString('hex'));console.log('SANCTUM_API_KEY_PEPPER='+c.randomBytes(32).toString('hex'))\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:webhook": "node scripts/test-render-webhook.mjs",
    "monitor": "tsx scripts/live-monitor.ts",
    "premonitor": "node scripts/ensure-env.mjs",
    "demo:console": "tsx scripts/console-intercept-demo.ts",
    "predemo:console": "node scripts/ensure-env.mjs",
    "example:agent": "tsx examples/agent-gate/run.ts",
    "preexample:npm": "node scripts/ensure-env.mjs",
    "example:npm": "node examples/npm-consumer/run.mjs",
    "build:sdk": "npm run build -w @sanctum-runtime/sdk",
    "build:adapter": "npm run build -w @sanctum-runtime/adapter-agent-runtime",
    "build:adapters": "npm run build -w @sanctum-runtime/adapters",
    "build:packages": "npm run build:sdk && npm run build:adapter && npm run build:adapters",
    "build:cli": "npm run build -w @sanctum-runtime/cli",
    "build:all-packages": "npm run build:packages && npm run build:cli",
    "build:dashboard": "npm run build:sdk && npm run build -w @sanctum/dashboard",
    "production:check": "node scripts/production-check.mjs",
    "seed:production": "node scripts/seed-production-demo.mjs",
    "example:connect": "tsx examples/runtime-connect/run.ts",
    "example:memory": "tsx examples/agent-memory/run.ts",
    "example:memory-rotate": "tsx examples/agent-memory/rotate.ts",
    "example:marketplace": "tsx examples/marketplace-connect/run.ts",
    "example:marketplace:smart-home": "tsx examples/marketplace-connect/smart-home.ts",
    "example:marketplace:ros2": "tsx examples/marketplace-connect/ros2.ts",
    "example:marketplace:finance": "tsx examples/marketplace-connect/finance.ts",
    "example:marketplace:langchain": "tsx examples/marketplace-connect/langchain.ts",
    "example:marketplace:crewai": "tsx examples/marketplace-connect/crewai.ts",
    "example:marketplace:mcp": "tsx examples/marketplace-connect/mcp.ts",
    "example:marketplace:humanoid": "tsx examples/marketplace-connect/humanoid.ts",
    "example:marketplace:embodied": "tsx examples/marketplace-connect/embodied.ts",
    "example:marketplace:ai-os": "tsx examples/marketplace-connect/ai-os.ts",
    "example:marketplace:healthcare": "tsx examples/marketplace-connect/healthcare.ts",
    "example:marketplace:mobility": "tsx examples/marketplace-connect/mobility.ts",
    "example:marketplace:companion": "tsx examples/marketplace-connect/companion.ts",
    "example:marketplace:industrial": "tsx examples/marketplace-connect/industrial.ts",
    "smoke:control-plane": "node scripts/smoke-control-plane.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test:all": "tsx scripts/test-all.mjs",
    "env:pull": "node scripts/pull-supabase-env.mjs",
    "db:push": "supabase db push",
    "db:status": "supabase migration list",
    "db:reset": "supabase db reset --linked",
    "predev:runtime": "node scripts/ensure-env.mjs && npm run build:sdk",
    "predev": "node scripts/ensure-env.mjs",
    "presmoke": "node scripts/ensure-env.mjs",
    "preexample:agent": "node scripts/ensure-env.mjs",
    "publish:sdk": "npm publish -w @sanctum-runtime/sdk --access public",
    "publish:adapter": "npm publish -w @sanctum-runtime/adapter-agent-runtime --access public",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "build": "vite build",
    "build:vercel": "vite build --config vite.config.vercel.ts",
    "cf:build": "npm ci && npm run build",
    "deploy": "npm run build && npx wrangler deploy",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.38.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/router-plugin": "^1.167.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.3.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.76.1",
    "react-resizable-panels": "^4.11.2",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "^1.7.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "chokidar": "^5.0.0",
    "concurrently": "^9.1.2",
    "dotenv": "^16.6.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "happy-dom": "^20.9.0",
    "lru-cache": "^11.5.0",
    "nitro": "^3.0.260429-beta",
    "prettier": "^3.7.3",
    "readdirp": "^5.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.3.1",
    "vitest": "^4.1.7"
  }
}
